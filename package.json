{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "See your Claude Code sessions as characters in a live 3D office.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-office": "bin/agent-office.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/agent-office.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "prepare": "npm run build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build:artifact": "vite build -c vite.cloud.config.ts && node scripts/inline-artifact.mjs"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@types/node": "^20.19.43",
    "@types/three": "^0.169.0",
    "jsdom": "^25.0.1",
    "marked": "^18.1.0",
    "playwright": "^1.64.0",
    "three": "^0.169.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
